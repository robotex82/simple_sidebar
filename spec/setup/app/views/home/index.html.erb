<h1>Home</h1>
<div id="main-content">
  <button data-sidebar-trigger="#sidebar1">Sidebar Left</button>
  <button data-sidebar-trigger="#sidebar2">Sidebar Right</button>
  <button data-sidebar-trigger="#sidebar3">Sidebar Top</button>
  <button data-sidebar-trigger="#sidebar4">Sidebar Bottom</button>
</div>
<%= simple_sidebar_helper(self).render_sidebar(:sidebar1, position: :left, mode: :push, container_html: { style: 'padding: 20px; overflow: scroll; background-color: red !important;'}) do %>
  <h3>This is sidebar Left</h3>
  <button data-sidebar-trigger="#sidebar1">Close me</button>
<% end %>
<%= simple_sidebar_helper(self).render_sidebar(:sidebar2, position: :right, container_html: { style: 'background-color: blue !important;'}) do %>
  <h3>This is sidebar Right</h3>
  <button data-sidebar-trigger="#sidebar2">Close me</button>
<% end %>
<%= simple_sidebar_helper(self).render_sidebar(:sidebar3, position: :top, container_html: { style: 'background-color: green !important;'}) do %>
  <h3>This is sidebar Top</h3>
  <button data-sidebar-trigger="#sidebar3">Close me</button>
<% end %>
<%= simple_sidebar_helper(self).render_sidebar(:sidebar4, position: :bottom, mode: :modal, container_html: { style: 'background-color: yellow !important;'}) do %>
  <h3>This is sidebar Bottom</h3>
  <button data-sidebar-trigger="#sidebar4">Close me</button>
<% end %>